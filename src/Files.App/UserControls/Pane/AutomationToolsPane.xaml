<UserControl
	x:Class="Files.App.UserControls.AutomationToolsPane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:items="using:Files.App.Data.Items"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:selectors="using:Files.App.Data.TemplateSelectors"
	xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
	Loaded="Root_Loaded"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<wctconverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
			<wctconverters:BoolToObjectConverter
				x:Key="NegateBoolToVisibilityConverter"
				FalseValue="Visible"
				TrueValue="Collapsed" />

			<!--  Package root: identity, version, aggregate health, and any package-fatal diagnostics.  -->
			<DataTemplate x:Key="AutomationPackageTemplate" x:DataType="items:AutomationPackageItem">
				<TreeViewItem
					AutomationProperties.Name="{x:Bind DisplayName}"
					IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
					ItemsSource="{x:Bind Actions}">
					<StackPanel
						Padding="0,4,0,4"
						HorizontalAlignment="Stretch"
						Spacing="2">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock
								VerticalAlignment="Center"
								Style="{ThemeResource BodyStrongTextBlockStyle}"
								Text="{x:Bind DisplayName}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock
								VerticalAlignment="Center"
								Foreground="{ThemeResource TextFillColorTertiaryBrush}"
								Style="{ThemeResource CaptionTextBlockStyle}"
								Text="{x:Bind PackageVersion}" />
						</StackPanel>
						<TextBlock
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Style="{ThemeResource CaptionTextBlockStyle}"
							Text="{x:Bind Description}"
							TextWrapping="Wrap"
							Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
						<TextBlock
							Foreground="{ThemeResource TextFillColorTertiaryBrush}"
							Style="{ThemeResource CaptionTextBlockStyle}"
							Text="{x:Bind HealthLabel}" />
						<TextBlock
							Foreground="{ThemeResource SystemFillColorCautionBrush}"
							Style="{ThemeResource CaptionTextBlockStyle}"
							Text="{x:Bind Diagnostics}"
							TextWrapping="Wrap"
							Visibility="{x:Bind HasDiagnostics, Converter={StaticResource BoolToVisibilityConverter}}" />
					</StackPanel>
				</TreeViewItem>
			</DataTemplate>

			<!--  Action child. Run stays disabled until invocation lands.  -->
			<DataTemplate x:Key="AutomationActionTemplate" x:DataType="items:AutomationActionItem">
				<TreeViewItem AutomationProperties.Name="{x:Bind DisplayName}" IsExpanded="False">
					<Grid
						Padding="0,4,0,4"
						HorizontalAlignment="Stretch"
						ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Spacing="2">
							<TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
							<TextBlock
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Style="{ThemeResource CaptionTextBlockStyle}"
								Text="{x:Bind Description}"
								TextWrapping="Wrap"
								Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
							<TextBlock
								Foreground="{ThemeResource TextFillColorTertiaryBrush}"
								Style="{ThemeResource CaptionTextBlockStyle}"
								Text="{x:Bind AvailabilityLabel}" />
							<TextBlock
								Foreground="{ThemeResource SystemFillColorCautionBrush}"
								Style="{ThemeResource CaptionTextBlockStyle}"
								Text="{x:Bind Diagnostics}"
								TextWrapping="Wrap"
								Visibility="{x:Bind HasDiagnostics, Converter={StaticResource BoolToVisibilityConverter}}" />
						</StackPanel>
						<Button
							Grid.Column="1"
							VerticalAlignment="Center"
							Content="{helpers:ResourceString Name=AutomationToolsRun}"
							IsEnabled="False"
							ToolTipService.ToolTip="{helpers:ResourceString Name=AutomationToolsRunNotYetAvailable}" />
					</Grid>
				</TreeViewItem>
			</DataTemplate>

			<selectors:AutomationToolsItemTemplateSelector
				x:Key="AutomationToolsItemTemplateSelector"
				ActionTemplate="{StaticResource AutomationActionTemplate}"
				PackageTemplate="{StaticResource AutomationPackageTemplate}" />
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid Padding="8" RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Filter and installation entry point  -->
		<Grid ColumnSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBox
				AutomationProperties.Name="{helpers:ResourceString Name=AutomationToolsFilter/AutomationProperties/Name}"
				PlaceholderText="{helpers:ResourceString Name=AutomationToolsFilter/PlaceholderText}"
				Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

			<Button
				Grid.Column="1"
				AutomationProperties.Name="{helpers:ResourceString Name=AutomationToolsOpenPackagesFolder}"
				Command="{x:Bind ViewModel.OpenPackagesFolderCommand}"
				Content="{helpers:ResourceString Name=AutomationToolsOpenPackagesFolder}"
				ToolTipService.ToolTip="{x:Bind ViewModel.PackagesFolderPath}" />
		</Grid>

		<TreeView
			Grid.Row="1"
			AutomationProperties.Name="{helpers:ResourceString Name=AutomationToolsTree/AutomationProperties/Name}"
			ItemTemplateSelector="{StaticResource AutomationToolsItemTemplateSelector}"
			ItemsSource="{x:Bind ViewModel.Packages}"
			SelectionMode="Single"
			Visibility="{x:Bind ViewModel.ShowTree, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

		<!--  Loading, empty, no-match, and unavailable all explain themselves in the same place.  -->
		<StackPanel
			Grid.Row="1"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Spacing="8"
			Visibility="{x:Bind ViewModel.ShowTree, Converter={StaticResource NegateBoolToVisibilityConverter}, Mode=OneWay}">
			<TextBlock
				HorizontalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{x:Bind ViewModel.Message, Mode=OneWay}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<TextBlock
				HorizontalAlignment="Center"
				Foreground="{ThemeResource TextFillColorTertiaryBrush}"
				Style="{ThemeResource CaptionTextBlockStyle}"
				Text="{helpers:ResourceString Name=AutomationToolsOpenPackagesFolderDescription}"
				TextAlignment="Center"
				TextWrapping="Wrap"
				Visibility="{x:Bind ViewModel.ShowPackagesFolderHint, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
		</StackPanel>
	</Grid>
</UserControl>
