<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
        <TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <Configurations>Debug;Release</Configurations>
        <Platforms>x86;x64;arm64</Platforms>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <IsAotCompatible>true</IsAotCompatible>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
        <ProjectReference Include="..\VxFiles.Automation.Abstractions\VxFiles.Automation.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="NativeMethods.txt" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Runtime\*.py">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>AutomationRuntime\%(Filename)%(Extension)</TargetPath>
        </Content>
		<Content Include="..\..\artifacts\python\3.14.6-win-x64\**\*" Condition="Exists('..\..\artifacts\python\3.14.6-win-x64\python.exe')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>AutomationRuntime\Python\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
		</Content>
    </ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>VxFiles.Automation.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<Target Name="EnsurePinnedPythonForPublish" BeforeTargets="PrepareForPublish">
		<Error Condition="!Exists('..\..\artifacts\python\3.14.6-win-x64\python.exe')" Text="The pinned CPython runtime is required for portable publishing. Run scripts\automation\Acquire-Python.ps1 first." />
	</Target>

</Project>
